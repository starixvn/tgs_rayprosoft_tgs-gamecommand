<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>0.0.7</Version>
		<Authors>Raypro</Authors>
		<Description>Tgs GameCommand Client</Description>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gamecommand</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gamecommand.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>tgs-gamecommand</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Http.Extensions" Version="2.2.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
		<PackageReference Include="PhoenixToolkits.NuGet.BuildTools" Version="0.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tgs.GameCommand.Common\Tgs.GameCommand.Common.csproj">
			<PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>
</Project>
